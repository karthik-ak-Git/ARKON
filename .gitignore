# ============================================
# ARKON — .gitignore
# ============================================

# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/

# ── Backend ─────────────────────────────────
backend/.env
backend/storage/

# ── Node ────────────────────────────────────
node_modules/
dist/
release/
pnpm-lock.yaml
package-lock.json
yarn.lock
bun.lock

# ── Desktop (Tauri) ────────────────────────
apps/desktop/node_modules/
apps/desktop/dist/
apps/desktop/release/

# ── Rust / Tauri ───────────────────────────
target/
src-tauri/target/
src-tauri/gen/
Cargo.lock

# ── Vite ────────────────────────────────────
.vite/

# ── Logs ────────────────────────────────────
logs/
*.log

# ── Hidden directories (not for public repo)
packages/
docs/
plugins/

# ── IDE ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ──────────────────────────────────────
.DS_Store
Thumbs.db

# ── Build outputs ───────────────────────────
release/
artifacts/
generated/
temp/
tmp/

# ── Generated binaries ─────────────────────
*.exe
*.msi
*.dll
*.obj
*.o
*.pdb

# ── Archives ────────────────────────────────
*.zip
*.7z
*.tar
*.gz
