# ARKON Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# APPLICATION
# ===========================================
APP_NAME=ARKON
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=DEBUG

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=arkon
POSTGRES_PASSWORD=arkon_dev_password
POSTGRES_DB=arkon

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ===========================================
# CACHE (Redis)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ===========================================
# EVENT BUS (NATS)
# ===========================================
NATS_HOST=localhost
NATS_PORT=4222
NATS_URL=nats://${NATS_HOST}:${NATS_PORT}

# ===========================================
# BACKEND (FastAPI)
# ===========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_RELOAD=true

# CORS
CORS_ORIGINS=["http://localhost:5173", "tauri://localhost"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ===========================================
# FRONTEND (Vite + Tauri)
# ===========================================
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_TITLE=ARKON

# ===========================================
# TAURI
# ===========================================
TAURI_WINDOW_TITLE=ARKON
TAURI_WINDOW_WIDTH=1400
TAURI_WINDOW_HEIGHT=900
TAURI_WINDOW_MIN_WIDTH=1000
TAURI_WINDOW_MIN_HEIGHT=700

# ===========================================
# PLUGINS
# ===========================================
PLUGIN_DIR=./plugins
PLUGIN_AUTO_LOAD=true

# ===========================================
# MONITORING
# ===========================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000