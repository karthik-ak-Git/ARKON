{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARKON",
  "version": "0.1.0",
  "identifier": "com.arkon.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ARKON",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "theme": "default"
      }
    ],
    "security": {
      "csp": "default-src 'self' data: 'unsafe-inline' 'unsafe-eval' http://localhost:5173 ws://localhost:8000; connect-src 'self' http://localhost:8000 ws://localhost:8000;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "dialog": {
      "open": true,
      "save": true
    },
    "fs": {
      "scope": {
        "allow": [
          "$APPDATA/ARKON/*",
          "$HOME/.arkon/*"
        ]
      }
    },
    "http": {
      "scope": [
        "http://localhost:8000/**",
        "ws://localhost:8000/**"
      ]
    },
    "notification": {
      "all": true
    },
    "updater": {
      "active": false
    }
  }
}